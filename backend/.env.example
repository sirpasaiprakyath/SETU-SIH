# SIH26186 Guardian Minds / SETU - Backend Environment Template
# Use these variables when configuring Render Web Service manually or locally.

# Python Version on Render
PYTHON_VERSION=3.11.9

# Port automatically assigned by Render ($PORT)
PORT=8000

# Security (JWT Auth)
JWT_SECRET=replace_with_a_secure_random_hex_key_min_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database Configuration
# For local development: sqlite:///./guardian_minds.db
# For Render Managed PostgreSQL: postgresql://setu_user:yourpassword@dpg-...-a.oregon-postgres.render.com/setu_db
# (Note: Both 'postgres://' and 'postgresql://' prefixes are automatically handled)
DATABASE_URL=sqlite:///./guardian_minds.db

# CORS Configuration: Comma-separated list of allowed frontend origins
# Wildcards (*.vercel.app and *.netlify.app) are already permitted by default regex
CORS_ORIGINS=https://your-frontend.vercel.app,https://your-frontend.netlify.app
FRONTEND_URL=https://your-frontend.vercel.app

# Governance & DPDP Act 2023 Compliance
AUDIT_ENABLED=True
DATA_RETENTION_DAYS=90

# Optional Supabase Integration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_key_here
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_key_here
